# Copy thành .env.production. Dùng localhost khi thử trên máy và tên miền thật trên VPS.
PUBLIC_HOST=localhost
# Khi mở cho internet trên VPS, đổi thành 0.0.0.0 và trỏ DNS của tên miền về VPS.
PUBLIC_BIND_IP=127.0.0.1

DB_NAME=preorder
DB_USER=preorder
DB_PASSWORD=

INITIAL_MANAGER_LOGIN_ID=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=Quản lý
