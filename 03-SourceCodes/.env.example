# Mẫu cấu hình môi trường local. Copy thành .env (đã nằm trong .gitignore) rồi sửa giá trị nếu cần.
# Docker Compose, backend và Vite cùng đọc file .env này.

# PostgreSQL (container trong compose.yaml)
DB_HOST=localhost
# Cổng trên máy host. Mặc định 5433 để không đụng PostgreSQL cài sẵn trên máy (thường chiếm 5432).
DB_PORT=5433
DB_NAME=preorder
DB_USER=preorder
DB_PASSWORD=change-me-local-only

# Backend Spring Boot; frontend Vite chuyển tiếp /api tới cổng này.
BACKEND_PORT=8080
